<!doctype html>
<html lang="no">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }}</title>
<!-- Fonts: brand-detected with safe fallbacks (no FOIT; swap). -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --cw: {{ canvas.width }}px;
  --ch: {{ canvas.height }}px;
  --head-font: "{{ fonts.heading }}", {{ fonts.fallback_heading }};
  --body-font: "{{ fonts.body }}", {{ fonts.fallback_body }};
}
{{ css }}
</style>
</head>
<body>
<div id="viewport">
  <div id="stage">
    {% for s in scenes %}
    <section class="scene" data-role="{{ s.role }}">
      {% if s.image %}<img class="scene__img" src="{{ s.image }}" alt="">{% endif %}
      <div class="scene__scrim"></div>
      <div class="scene__grain"></div>
      <div class="scene__vignette"></div>
      {% if s.logo %}<img class="logo" data-place="{{ s.role }}" src="{{ s.logo }}" alt="logo">{% endif %}
      <div class="copy" data-anchor="{{ 'center' if s.role == 'cta' else 'bottom' }}">
        {% if s.copy.kicker %}<div class="kicker">{{ s.copy.kicker }}</div>{% endif %}
        {% if s.copy.headline %}<div class="headline">{{ s.copy.headline }}</div>{% endif %}
        {% if s.copy.sub %}<div class="sub">{{ s.copy.sub }}</div>{% endif %}
      </div>
    </section>
    {% endfor %}
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script>
  window.SCENE_PLAN = {{ scene_plan_json | safe }};
  window.SCENE_PLAN._canvas_w = {{ canvas.width }};
  window.SCENE_PLAN._canvas_h = {{ canvas.height }};
  window.VISUAL = {{ visual_json | safe }};
  window.PREVIEW = {{ preview }};
</script>
<script>{{ js | safe }}</script>
</body>
</html>
