{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "qa_report",
  "type": "object",
  "required": ["passed", "checks", "verdict"],
  "properties": {
    "slug": {"type": "string"},
    "passed": {"type": "boolean"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "total": {"type": "integer"},
    "failed": {"type": "integer"},
    "verdict": {"type": "string"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "ok"],
        "properties": {
          "check": {"type": "string"},
          "ok": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
